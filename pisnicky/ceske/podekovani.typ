#show: doc => song(
  title: [Poděkování],
  author: [Hradišťan],
  font_size: 0.95em,
  line_spacing: 0.58em,
  doc,
)

#solo[
  #rep[
    #rep(repeat: 3)[A D]
    A  D  E  A
  ]
]

#verse[
  #c[E]Poděkujme #c[A]jak děti #c[H]za jabl#c[E]ko,\
  #c[H]za vše co #c[E]bývalo a #c[H]znovu kdysi bude,\
  #c[G]za to, že #c[D]věrná po dni #c[G]přicházela #c[C]noc,\
  za #c[A]zarputilé #c[D]rá#c[A]no.#c[D]
]

#solo[
  #rep[
    #rep[A D]
    A  D  E  A
  ]
]

#verse[
  #c[E]Poděkujme #c[A]jak děti #c[H]za jabl#c[E]ko,\
  #c[H]za to, že #c[E]příští dávno #c[H]je už za námi.\
  #c[G]Poděkujme #c[D]jak děti #c[G]za jabl#c[C]ko,\
  #c[D]že nás měl #c[G]čas jak #c[D]rybář rybu #c[G]v sí#c[D]ti.#s[G]
]

#solo[
  #rep[
    #rep[D G]
    D  G  A  D
  ]
]

