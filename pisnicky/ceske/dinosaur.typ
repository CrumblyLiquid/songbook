#import "@local/crumblysong:0.1.0": *;

#import "/style.typ": style;
#show: style

#show: doc => song(
  title: [Dinosaur],
  author: [Kruh 19],
  url: "https://www.youtube.com/watch?v=0W-H1hW-uno",
  doc,
)

#solo[
  Ami C
]

#verse[
  #c[G]Podívej se brácho na toho #c[C]sejčka.\
  Nepřemejšlim jako malej, jak dělá #c[Emi]liška.\
  Všichni se mě #c[Ami]ptaj, co dělá #c[C]vejška.\
  #ca[G]Nikoho už nezajímá oblíbená #ca[C]knížka (ani film),\
  oni mě soudí podle #ca[Emi]toho,\
  jestli dávám #ca[Ami]dýška (možná #ca[C]ne).
]

#chorus[
  #c[Ami]Dlouho se mě nikdo #c[Emi]nezeptal,\
  jakej je #c[Hmi]můj oblíbenej #c[C]dinosaur. (nezeptal)\
  #ca[Ami]Dlouho se mě nikdo #ca[Emi]nezeptal,\
  je to stego#ca[Hmi]saur, je to stego#ca[C]saur.
]

#solo[
  G C Em Am C
]

#verse[
  #ca[G]Pamatuješ Káti, jezdili jsme #ca[C]rádi\
  na plastový #ca[Emi]motorce,\
  teď to nejde #ca[Ami]do vzorce a ty pracuješ #ca[C]v laborce.\
  #ca[G]A už je to dávno, co bylo lehký #ca[C]táhnout,\
  za jeden #ca[Emi]konec,\
  nám zazvonil #ca[Ami]zvonec a už to nejde #ca[C]zvládnout.
]

// TODO: Číslované refrény
#chorus[
  #ca[Ami]Dlouho se mě nikdo #ca[Emi]nezeptal,\
  jakej je #ca[Hmi]můj oblíbenej #ca[C]dinosaur. (nezeptal)\
  #ca[Ami]Dlouho se mě nikdo #ca[Emi]nezeptal,\
  je to stego#ca[Hmi]saur, je to stego#ca[C]saur.

  #ca[Ami]Dlouho se tě nikdo #ca[Emi]nezeptal,\
  jakej je #ca[Hmi]tvůj oblíbenej #ca[C]dinosaur. (nezeptal)\
  #ca[Ami]Dlouho se tě nikdo #ca[Emi]nezeptal,\
  jakej je to #ca[Hmi]saur, jakej je to #ca[C]saur.
]

#bridge[
  #c[G]Nějakej pán mi řek: vy už nejste #c[C]děti,\
  už nejste děti, vy už nejste #c[Ami]děti.\
  Ty si na to #c[Emi]káp, už nejsme #c[C]děti.

  #ca[G]Občas se sám ptám, proč už nejsme #ca[C]děti,\
  proč nejsme děti, proč už nejsme #ca[Ami]děti.\
  Ty si na to #ca[Emi]káp, už nejsme #ca[C]děti...
]


#chorus[
  Dlouho se mě nikdo nezeptal...

  Dlouho se tě nikdo nezeptal...
]


#chorus[
  #c[Ami]Ááá#w[Emi]ááá #s[Hmi]ááá#w[C]ááá\
  Jakej je to #c[Ami]saur, ááá#w[Emi]ááá #s[Hmi]ááá#w[C]ááá\

  #c[Ami]Dlouho se tě #c[Emi]nezeptal\
  #c[Hmi]Nikdo se tě #c[C]nezeptal.

  #c[Ami]Ááá#w[Emi]ááá #s[Hmi]ááá#w[C]ááá...
]
