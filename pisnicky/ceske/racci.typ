#import "@local/crumblysong:0.1.0": *;

#import "/style.typ": style;
#show: style

#show: doc => song(
  title: [Racci],
  author: [Cermaque],
  doc,
)

#verse[
  #c[Emi]Tak dlouho volal racek #c[G]do prázdna\
  #c[Hmi]až z prázdna lásku přivo#c[A]lal\
  #c[Emi]Ten příboj doplul sem až #c[G]z dna\
  #c[Hmi]dva racci tančí u mo#c[A]la.
]

#verse[
  #ca[Emi]Noc barví moře #ca[G]sametovou tuší\
  #ca[Hmi]potom on vzlétne, #ca[A]ona netuší\
  #ca[Emi]zda už ji opustil #ca[G]\
  #ca[Hmi]či pro ni hledá bezpe#ca[A]čí.
]

#verse[
  #ca[Emi]A vše je jedno, #ca[G]vše je dobře\
  #ca[Hmi]že moře nikdy neml#ca[A]čí\
  #ca[Emi]Ránu co nechá jedna #ca[G]vlna\
  #ca[Hmi]vždy další vlna vylé#ca[A]čí
]

#chorus[
  #rep(repeat: 3)[
    Já a #c[Emi]ty, vlna #c[G]za vlnou\
    #c[Hmi]to moře mává #c[A]křídly
  ]
]

#verse[
  #ca[Emi]Stařičký démon Posei#ca[G]don\
  #ca[Hmi]vidlice místo obo#ca[A]čí\
  #ca[Emi]a v očích mořské propas#ca[G]ti\
  #ca[Hmi]hlídá ať láska, #ca[A]nikdy neotročí\
  #ca[Emi]Ať vlna za vlnou #ca[G]\
  #ca[Hmi]nežene srdce do pas#ca[A]tí
]

#chorus[
  Já a ty, vlna za vlnou...
]
