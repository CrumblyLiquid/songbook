#import "@local/crumblysong:0.1.0": *;

#show: doc => song(
  title: [Trpasličí svatba],
  author: [Zdeněk Svěrák a Jaroslav Uhlíř],
  doc,
)

#verse[
  #c[C]V lese, jó v lese #c[F]na jehli#c[C]čí,\
  #c[C]koná se svatba #c[D]trpasli#c[G]čí,\
  #c[C]žádná divná #c[F]věc to ne#c[E]ní,\
  #c[F]Šmudla už má #c[C]po vojně a #c[F]tak se #c[G]že#c[C]ní.
]<v-lese-jo-v-lese>

#verse[
  #ca[C]Malou má ženu, #ca[F]malinka#ca[C]tou,\
  #ca[C]s malým věnem, #ca[D]malou cha#ca[G]tou.\
  #ca[C]Už jim choděj' #ca[F]telegrám#ca[E]ky,\
  #ca[F]už jim hrajou #ca[C]Mendelssohna #ca[F]na var#ca[G]hán#ca[C]ky.
]

#chorus[
  Protože #c[G]láska, láska, láska v každém #c[C]srdci klí#c[G]čí,\
  protože #c[G]láskou hoří i to srdce #c[C]trpasli#c[G]čí\
  a kdo se #c[G]v téhle věci jednoduše #c[C]neopi#c[G]čí,\
  ten ať se #c[G]dívá, co se děje v lese #c[C]na jehli#c[G]čí.
]

#verse[
  #ca[C]Mají tam lásku, #ca[F]jako trá#ca[C]mek,\
  #ca[C]pláče tchýňka, #ca[D]pláče tchá#ca[G]nek,\
  #ca[C]štěstíčko přejou #ca[F]mladí, sta#ca[E]ří,\
  #ca[F]v papinově #ca[C]hrníčku se #ca[F]maso #ca[G]va#ca[C]ří.
]

#verse[
  #ca[C]Pijou tam pivo #ca[F]popovic#ca[C]ký,\
  #ca[C]Šmudla se polil, #ca[D]jako vždy#ca[G]cky,\
  #ca[C]Kejchal kejchá na #ca[F]Profou#ca[E]se,\
  #ca[F]jedí hrášek #ca[C]s uzeným a #ca[F]nafouk#ca[G]nou #ca[C]se.
]

#chorus[
  Protože láska...
]

#verse(ref: <v-lese-jo-v-lese>)[
  V lese, jó v lese...
]

