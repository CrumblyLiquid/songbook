#import "@local/crumblysong:0.1.0": *;

#import "/style.typ": style;
#show: style

#show: doc => song(
  title: [Psí balada],
  author: [Michal Horák],
  url: "https://www.youtube.com/watch?v=sPApWvFVGAg",
  doc,
)

#section[
  _Původně jsem s tímhle songem nechtěl jít vůbec ven,\
  protože jsem nechtěl aby si lidi mysleli že zpívám jenom\
  o mrtvejch zvířatech, ačkoli vlastně je to docela pravda.\
  Ale co už, takhle mi to říkala kamarádka... true story._
]

#verse[
  #c[Dmi]Známá #c[B]volala mi, #c[C]že jede na #c[F]do#c[A]vču,\
  #c[Dmi]a že #s[B]jestli jí prej #c[C]nepohlídám #c[Dmi]psa.\
  #c[Dmi]Tak jsem #c[B]řekla, že si #c[C]o psech něco #c[F]pro#c[A]čtu,\
  #c[Dmi]a už #s[B]do diáře #c[C]psala jsem si #c[Dmi]psa.

  #c[Dmi]Odvezla jsem si ho na byt\
  #c[F7]s cílem toho psa nezabít,\
  #c[B]co čert nechtěl, ten pes umřel #c[G/H]sám.\
  #c[F/C]Z toho už se nevykroutím,\
  #c[A/Cis]zhroutím se a pak zavolám.
]

#chorus[
  #c[Dmi]Pa pa #c[B]pá pa da pá, #c[C]ja pa pa da #c[F]pá da,\
  #c[Dmi]pa pa #c[B]já pa da pá, #c[C]ja pa pa da #c[Dmi]pa.\
]

#verse[
  #ca[Dmi]Nic se #ca[B]neděje, jo #ca[C]to se prostě #ca[F]stá#ca[A]vá,\
  #ca[Dmi]byl fakt #ca[B]starej, není #ca[C]divit se če#ca[Dmi]mu.\
  #ca[Dmi]Dovez #ca[B]ho k nám domů, #ca[C]ať tam nezů#ca[F]stá#ca[A]vá,\
  #ca[Dmi]Funus #ca[B]důstojnej pak #ca[C]vystrojíme #ca[Dmi]mu.

  #ca[Dmi]Pak mi známá zavěsila,\
  #ca[F7]aniž by mi vysvětlila,\
  #ca[B]jak psa přes půl Prahy přemís#ca[G/H]tit.\
  #ca[F/C]A tak s kufrem příručním\
  #ca[A/Cis]a s mrtvolou v něm jedu metrem.
]

#chorus[
  Pa pa...
]

#verse[
  #ca[Dmi]Vážně #ca[B]připadala #ca[C]jsem si jako #ca[F]zlo#ca[A]duch,\
  #ca[Dmi]co by #ca[B]od Greenpeace měl #ca[C]dostat po tla#ca[Dmi]mě.\
  #ca[Dmi]A když #ca[B]tlačila jsem #ca[C]ten kufr do #ca[F]scho#ca[A]dů,\
  #ca[Dmi]ňákej #ca[B]kolemjdoucí #ca[C]kluk se zeptal #ca[Dmi]mě:

  "#ca[Dmi]Nechcete s tím slečno pomoct?"\
  "#ca[F7]Tak coby ne, děkuju moc."\
  #ca[B]Řekla jsem a kufr poda#ca[G/H]la.\
  "#ca[F/C]Vy se teda nataháte,\
  #ca[A/Cis]to je tíha, co v tom máte?"

  "#ca[Dmi]Ále, ňáký počítače\
  #ca[F7]do práce si musím vláčet."\
  #ca[B]-- tak neřeknu, že mám v kufru #ca[G/H]psa?!\
  #ca[F/C]A dřív než bys řekl "noha",\
  #ca[A/Cis]kluk i s kufrem vzal mi roha.
]

#chorus[
  Pa pa...
]

#bridge[
  #c[B]A tak končí #c[Dmi]příběh, kterej #c[A]vážně se mi #c[Dmi]stal.\
  #c[B]Škoda jen, že #c[F]psovi lepší #c[G/H]osud nechy#c[C]stal.\
  #c[B]A když je mi #c[F]na nic, odteď #c[C]vždycky #c[B]zabírá\
  #c[Gmi]představa, jak #c[Dmi]kluk si ten můj #c[A]kufr otví#c[Dmi]rá.
]

#chorus[
  #c[Dmi]Pa pa #c[B]já pa dá pa #c[C]ja pa pa da #c[Dmi]pa.
]
