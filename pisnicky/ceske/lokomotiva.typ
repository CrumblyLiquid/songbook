#import "@local/crumblysong:0.1.0": *;

#show: doc => song(
  title: [Lokomotiva],
  author: [Poletíme?],
  url: "https://www.youtube.com/watch?v=iKpdb2ffNHE",
  line_spacing: 0.6em,
  doc,
)

#verse[
  #c[G]Pokaždé když tě vidím, #c[D]vím, že by to šlo\
  a když #c[Emi]jsem přemejšlel, co cítím, #c[C]tak mě napadlo.\
  Jestli #ca[G]nechceš svýho osla vedle #ca[D]mýho osla hnát,\
  jestli #ca[Emi]nechceš se mnou tahat ze ze#ca[C]mě rezavej drát.
]

#chorus[
  #c[G]Jsi loko#c[D]motiva, kte#c[Emi]rá se řítí #c[C]tmou,\
  #ca[G]jsi indi#ca[D]áni, kteří #ca[Emi]prérií je#ca[C]dou,\
  #ca[G]jsi kulka #ca[D]vystřelená #ca[Emi]do mojí hla#ca[C]vy,\
  #ca[G]jsi prezi#ca[D]dent a já tvé #ca[Emi]spojené stá#ca[C]ty.
]<lokomotiva>

#solo[G D Emi C ~~ G D Emi C _(sólo housle)_]

#verse[
  #ca[G]Přines jsem ti kytku, no co #ca[D]koukáš, to se má,\
  je to #ca[Emi]koruna žvejkačkou ke špej#ca[C]li přilepená.\
  A dva #ca[G]kelímky vod jogurtu, co je #ca[D]mezi nima niť,\
  může#ca[Emi]me si takhle vždycky volat, #ca[C]když budeme chtít.
]

#chorus(ref: <lokomotiva>)[
  Jsi lokomotiva...
]

#solo[G D Emi C ~~ G D Emi C _(sólo trumpeta)_]

#verse[
  #ca[G]Každej příběh má svůj konec, ale #ca[D]né, ten náš,\
  #ca[Emi]nám to bude navždy dojit všude, #ca[C]kam se podíváš.\
  Naše #ca[G]kachny budou zlato nosit a #ca[D]krmit se popcornem,\
  já to #ca[Emi]každej večer spláchnu, půl#ca[C]nočním expresem.
]

#chorus(ref: <lokomotiva>)[
  Jsi lokomotiva...
]

#solo[G D Emi C ~~ G D Emi C _(sólo banjo)_]

#verse[
  #ca[G]Dětem dáme jména Jessie, #ca[D]Jared, Jack a John,\
  ve sto#ca[Emi]padesáti letech ho budu mít #ca[C]stále jako slon.\
  A ty ne#ca[G]ztratíš svoji krásu, stále #ca[D]štíhlá kolem pasu,\
  stále #ca[Emi]dokážeš mě chytit lasem #ca[C]a přitáhnout na terasu.
]

#chorus(ref: <lokomotiva>)[
  Jsi lokomotiva...
]

#chorus(ref: <lokomotiva>)[
  Jsi lokomotiva... _(a capella - jen bicí)_
]

#chorus(ref: <lokomotiva>)[
  Jsi lokomotiva...
  #c[G]Já a ty
]

