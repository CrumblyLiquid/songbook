#verse[
  #c[G]Povídej, jestli tě #c[D]má hodně rád, víc než #c[G]já,\
  #c[G]jestli když večer jdeš #c[D]spát ti polibek #c[G]dá,\
  #c[G]tak jako #c[Hmi]já, to už je #c[C]dávno, tak poví#c[G]dej, #c[D7]hej poví#c[G]dej.
]

#verse[
  #ca[G]Povídej nechal tě #ca[D]být, vždyť měl tě tak #ca[G]rád.\
  #ca[G]Nebo's ho nechala #ca[D]jít, když šel s jinou #ca[G]spát\
  #ca[G]tak jako #ca[Hmi]mně, to už je #ca[C]dávno, tak poví#ca[G]dej, #ca[D7]hej poví#ca[G]dej
]

#bridge[
  Áááá Áááá Áááá Áááá Áááá Áááá Áááá
]

#chorus[
  Poví#w[Hmi]dej, #s[G]jestli se ti po mně #c[A]stýská,\
  #c[C] Když jdeš večer #c[G]spát,\
  #c[G]Jestli když večer se #c[A]blýská,\
  #c[C] Nepřestala ses #c[G]bát.
]

#verse[
  #ca[G]Povídej, ne já se #ca[D]nevrátím, jdi domů #ca[G]spát.\
  #ca[G]Svou lásku ti vypla#ca[D]tím, víc nemůžu #ca[G]dát\
  #ca[G]Jak jsem dal #ca[Hmi]dřív, to už je #ca[C]dávno tak poví#ca[G]dej, #ca[D7]hej poví#ca[G]dej.\
  Poví#ca[Hmi]dej, poví#ca[C]dej, poví#ca[G]dej...
]

